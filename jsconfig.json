{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/app/*": ["src/app/*"],
      "@/components/*": ["src/components/*"],
      "@/data/*": ["src/data/*"],
      "@/features/*": ["src/features/*"],
      "@/lib/*": ["src/lib/*"]
    },
    "checkJs": false,
    "jsx": "react-jsx"
  },
  "exclude": ["node_modules", "dist"]
}
